# =================================================================
# SMARTSHOP BACKEND ENVIRONMENT VARIABLES (FOR RENDER DEPLOYMENT)
# =================================================================

# Server Port (Render sets this automatically, default: 5000)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartshop?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/smartshop?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_key_smartshop_2026

# Cloudinary Credentials (For Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Credentials (Optional / Payment Gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Deployed Frontend & Admin URLs (For CORS Whitelist)
FRONTEND_URL=https://smartshop-customer.vercel.app
ADMIN_URL=https://smartshop-admin.vercel.app
