# ===================================================
# SmartShop - Root .gitignore (Fullstack Monorepo)
# ===================================================

# Dependencies
node_modules/
*/node_modules/
.pnp/
.pnp.js

# Environment variables & secrets (CRITICAL FOR GITHUB)
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env
admin/.env
!.env.example

# Production builds & distribution
dist/
*/dist/
dist-ssr/
build/
*/build/
out/
.next/

# Runtime uploads & temporary storage
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
tmp/
temp/
*.tmp

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Testing & coverage
coverage/
*.lcov
.nyc_output/

# Agents & workspace metadata
.agents/
.system_generated/
